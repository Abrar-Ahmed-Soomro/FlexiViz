# FlexiViz staging configuration (used by the pm2 container).
# server.js loads this file when APP_ENV=staging is set on the process.
# Values here use Docker service names instead of localhost.

# Process mode + listen address
NODE_ENV=production
PORT=3030
HOST=0.0.0.0

# MongoDB connection string -- MongoDB runs in its own container and is
# reachable by its service name on the shared Docker network.
MONGODB_URI=mongodb://mongodb:27017/flexiviz

# Auth -- replace with a random string at least 32 chars long
JWT_SECRET=replace-with-a-random-string-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# Public base URL (inlined into the app at `next build` time)
NEXT_PUBLIC_APP_URL=http://localhost:3030

# Path to the DuckDB database file (created automatically)
DUCKDB_PATH=./data/flexiviz.duckdb