# FlexiViz environment setup
# Copy this file to .env.local (development) or use it as a template for
# production/staging. Never commit real secrets.
#
#   cp .env.example .env.local
#
# Required variables: MONGODB_URI, JWT_SECRET (>= 32 chars).
# Everything else has a sane default.

# Process mode: development | production | test
NODE_ENV=development

# Listen address for the custom server (server.js). APP_ENV picks an
# environment overlay: APP_ENV=staging loads .env.staging (port 3030).
# Leave APP_ENV unset to use plain .env.
PORT=3000
HOST=0.0.0.0
APP_ENV=

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/flexiviz

# Auth -- replace with a random string at least 32 chars long
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# Public base URL of the app (used for links/verification emails in production).
# NOTE: inlined into the app at `next build` time, so set the real URL per
# environment before building.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Path to the DuckDB database file (created automatically)
DUCKDB_PATH=./data/flexiviz.duckdb